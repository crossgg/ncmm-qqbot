# NCMM QQ 机器人配置文件示例
# 提示: 本插件已内置在线网页配置面板，启动后可在浏览器打开 http://127.0.0.1:5606 在线填写，无需手动编辑此文件！

# 是否自动在宿主 notify.yaml 中配置并启用 Webhook 通知（端口与下方 port 保持一致）
auto_notify: true

# 腾讯 QQ 开放平台申请的机器人 AppID
app_id: ""

# 机器人 AppSecret (ClientSecret)
client_secret: ""

# 管理员专属 QQ OpenID（在 QQ 私聊机器人发送 /myid 即可快速获取）
admin_openid: ""

# 本地服务端口（默认 5606，用于 Web 管理面板以及接收 ncmm 的 notify 消息）
port: 5606

# 监听地址（默认 127.0.0.1 仅限本机；若需局域网访问独立面板可改为 0.0.0.0）
host: "127.0.0.1"

# ncmm 宿主主目录与可执行文件路径（程序会自动探测，留空即可）
ncmm_home: ""
ncmm_exe: ""
